      <column caption='Department Null Check' datatype='string' name='[Calculation_0669930924089344]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Department_Code])&#13;&#10;OR TRIM([Department_Code]) = &quot;&quot;&#13;&#10;THEN &quot;Missing&quot;&#13;&#10;ELSE &quot;Valid&quot;&#13;&#10;END' />
      </column>
      <column caption='Transaction ID Quality' datatype='string' name='[Calculation_0669931020324865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Transaction_ID])&#13;&#10;OR TRIM([Transaction_ID]) = &quot;&quot;&#13;&#10;THEN &quot;Missing&quot;&#13;&#10;ELSE &quot;Valid&quot;&#13;&#10;END' />
      </column>
      <column caption='Duplicate Transaction ID Count' datatype='integer' name='[Calculation_0669931025829890]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Transaction_ID])-COUNTD([Transaction_ID])' />
      </column>
      <column caption='Transaction ID Occurrences' datatype='integer' name='[Calculation_0669931127705603]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Transaction_ID]:COUNT([Transaction_ID])}' />
      </column>
      <column caption='Exact Duplicate Occurrences' datatype='integer' name='[Calculation_0669931208802308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED&#13;&#10;    [Transaction_ID],&#13;&#10;    [Posting_Date],&#13;&#10;    [Department_Code],&#13;&#10;    [Account_Code],&#13;&#10;    [Amount_CAD],&#13;&#10;    [Currency],&#13;&#10;    [Description]&#13;&#10;  : COUNT([Transaction_ID])&#13;&#10;}' />
      </column>
      <column caption='Posting Date Quality' datatype='string' name='[Calculation_0669931229966341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Posting_Date]) THEN&#13;&#10;    &quot;Missing&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Valid&quot;&#13;&#10;END' />
      </column>
      <column caption='Amount CAD Quality' datatype='string' name='[Calculation_0669931248140294]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Amount_CAD]) THEN&#13;&#10;    &quot;Missing&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Valid&quot;&#13;&#10;END' />
      </column>
      <column caption='Amount CAD Status' datatype='string' name='[Calculation_0669931256836103]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Amount_CAD]) THEN &quot;Missing&quot;&#13;&#10;ELSEIF [Amount_CAD] = 0 THEN &quot;Zero&quot;&#13;&#10;ELSEIF [Amount_CAD] &lt; 0 THEN &quot;Negative&quot;&#13;&#10;ELSE &quot;Positive&quot;&#13;&#10;END' />
      </column>
      <column caption='Lookup Account Code Quality' datatype='string' name='[Calculation_0669931513815049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Account_Code (Chart!of!Accounts)]) OR TRIM([Account_Code (Chart!of!Accounts)])= &quot;&quot; &#13;&#10;THEN &quot;Missing&quot; ELSE &quot;Valid&quot; &#13;&#10;END' />
      </column>
      <column caption='Department Display Name' datatype='string' name='[Calculation_0669931593068554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Department_Name]) THEN&#13;&#10;    &quot;Unassigned Department&quot;&#13;&#10;ELSE&#13;&#10;    [Department_Name]&#13;&#10;END' />
      </column>
      <column caption='Budget Variance CAD' datatype='real' name='[Calculation_0669931908120589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount_CAD]) - SUM([Budget_Amount_CAD])' />
      </column>
      <column caption='Performance Variance CAD' datatype='real' name='[Calculation_0669931945857038]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([Financial_Category]) = &quot;Revenue&quot; THEN&#13;&#10;    [Calculation_0669931908120589]&#13;&#10;ELSEIF ATTR([Financial_Category]) = &quot;COGS&quot;&#13;&#10;    OR ATTR([Financial_Category]) = &quot;Operating Expense&quot; THEN&#13;&#10;    -[Calculation_0669931908120589]&#13;&#10;END' />
      </column>
      <column caption='Revenue Performance Variance ' datatype='real' default-format='c&quot;$&quot;#,##0,,.000M;-&quot;$&quot;#,##0,,.000M' name='[Calculation_0669931973640207]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;Revenue&quot;&#13;&#10;        THEN [Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)&#13;&#10;-&#13;&#10;ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;Revenue&quot;&#13;&#10;        THEN [Budget_Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='COGS Performance Variance' datatype='real' default-format='c&quot;$&quot;#,##0,,.000M;-&quot;$&quot;#,##0,,.000M' name='[Calculation_0669931974782992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;COGS&quot;&#13;&#10;        THEN [Budget_Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)&#13;&#10;-&#13;&#10;ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;COGS&quot;&#13;&#10;        THEN [Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Operating Expense Variance' datatype='real' default-format='c&quot;$&quot;#,##0,,.000M;-&quot;$&quot;#,##0,,.000M' name='[Calculation_0669931975643153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;Operating Expense&quot;&#13;&#10;        THEN [Budget_Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)&#13;&#10;-&#13;&#10;ZN(&#13;&#10;    SUM(&#13;&#10;        IF [Financial_Category] = &quot;Operating Expense&quot;&#13;&#10;        THEN [Amount_CAD]&#13;&#10;        END&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Company Performance Variance CAD' datatype='real' default-format='c&quot;$&quot;#,##0,.000K;-&quot;$&quot;#,##0,.000K' name='[Calculation_0669931981496338]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0669931973640207]&#13;&#10;+&#13;&#10;[Calculation_0669931974782992]&#13;&#10;+&#13;&#10;[Calculation_0669931975643153]' />
      </column>
      <column caption='Adjusted Budget CAD' datatype='real' name='[Calculation_1034975119036417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Budget_Amount_CAD] * (1 + [Parameters].[Parameter 1034975112675328] / 100)' />
      </column>
      <column caption='Scenario Variance CAD' datatype='real' name='[Calculation_1034975133421572]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount_CAD]) - SUM([Calculation_1034975119036417])' />
      </column>
      <column caption='Expense Scenario Performance Variance' datatype='real' name='[Calculation_1034975316402182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1034975119036417])-SUM([Amount_CAD])' />
      </column>
      <column caption='Operating Variance Status' datatype='string' name='[Calculation_1590224244449282]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0669931975643153] &lt; 0 THEN&#13;&#10;    &quot;Favorable&quot;&#13;&#10;ELSEIF [Calculation_0669931975643153] &gt; 0 THEN&#13;&#10;    &quot;Unfavorable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;On Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Revenue Variance Status' datatype='string' name='[Calculation_1590224261898243]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0669931973640207] &gt; 0 THEN&#13;&#10;    &quot;Favorable&quot;&#13;&#10;ELSEIF [Calculation_0669931973640207] &lt; 0 THEN&#13;&#10;    &quot;Unfavorable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;On Budget&quot;&#13;&#10;END' />
      </column>
