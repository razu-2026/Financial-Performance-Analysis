              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xnzz0p1ky48a018m45p31oo4qw8].[sum:Amount_CAD:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xnzz0p1ky48a018m45p31oo4qw8].[sum:Budget_Amount_CAD:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xnzz0p1ky48a018m45p31oo4qw8].[usr:Calculation_0669931908120589:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0xnzz0p1ky48a018m45p31oo4qw8].[usr:Calculation_0669931945857038:qk]&quot;' />
