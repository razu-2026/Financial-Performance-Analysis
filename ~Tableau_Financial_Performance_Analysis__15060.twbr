    <worksheet name='Operating Expense Scenario'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='15'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Actual_Transactions+ (Multiple Connections)' name='federated.0xnzz0p1ky48a018m45p31oo4qw8' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Budget Adjustment %' datatype='real' name='[Parameter 1034975112675328]' param-domain-type='range' role='measure' type='quantitative' value='10.0'>
              <calculation class='tableau' formula='10.0' />
              <range granularity='1.0' max='20.0' min='-20.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0xnzz0p1ky48a018m45p31oo4qw8'>
            <column caption='Amount CAD' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Amount_CAD]' role='measure' type='quantitative' />
            <column caption='Budget Amount CAD' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;-&quot;$&quot;#,##0,,.00M' name='[Budget_Amount_CAD]' role='measure' type='quantitative' />
            <column caption='Adjusted Budget CAD' datatype='real' name='[Calculation_1034975119036417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Budget_Amount_CAD] * (1 + [Parameters].[Parameter 1034975112675328] / 100)' />
            </column>
            <column caption='Expense Scenario Performance Variance' datatype='real' name='[Calculation_1034975316402182]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1034975119036417])-SUM([Amount_CAD])' />
            </column>
            <column caption='Financial Category' datatype='string' name='[Financial_Category]' role='dimension' type='nominal' />
            <column-instance column='[Financial_Category]' derivation='None' name='[none:Financial_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Amount_CAD]' derivation='Sum' name='[sum:Amount_CAD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Budget_Amount_CAD]' derivation='Sum' name='[sum:Budget_Amount_CAD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1034975119036417]' derivation='Sum' name='[sum:Calculation_1034975119036417:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1034975316402182]' derivation='User' name='[usr:Calculation_1034975316402182:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
