              <calculation class='tableau' formula='IF [Calculation_0669931975643153] &lt; 0 THEN&#13;&#10;    &quot;Favorable&quot;&#13;&#10;ELSEIF [Calculation_0669931975643153] &gt; 0 THEN&#13;&#10;    &quot;Unfavorable&quot;&#13;&#10;ELSE&#13;&#10;    &quot;On Budget&quot;&#13;&#10;END' />
